# Discord Developer Portal の Bot 画面で取得したトークン
DISCORD_MAINT_TOKEN=
# DiscordサーバーのID
DISCORD_GUILD_ID=
# 許可チャンネル名。# なし、カンマ区切り
DISCORD_MAINT_CHANNELS=maintenance
# 任意: 添付専用フォルダの絶対パス。未設定なら添付不可
# Windows例: C:/discord-uploads
DISCORD_MAINT_UPLOAD_ROOTS=
# 任意: 投稿記録の保存先（絶対パスを推奨）
DISCORD_MAINT_LOG=
# 任意: 1ファイルの上限（MiB、既定10）
# DISCORD_MAINT_MAX_FILE_MB=10
